# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/sabangkarsa
# Or MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/sabangkarsa

# Server Configuration
PORT=3001
NODE_ENV=production

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Frontend URL (untuk redirect payment)
FRONTEND_URL=https://your-nextjs-domain.vercel.app
# Development: http://localhost:3000

# Xendit Configuration (Get from https://dashboard.xendit.co)
XENDIT_SECRET_KEY=your_xendit_secret_key_here
XENDIT_PUBLIC_KEY=your_xendit_public_key_here
XENDIT_CALLBACK_TOKEN=your_xendit_webhook_callback_token

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# CORS Origin
CORS_ORIGIN=https://your-nextjs-domain.vercel.app
# Development: http://localhost:3000

# Midtrans Configuration (Get from https://dashboard.midtrans.com)
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here

# Google OAuth (Get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Nila chatbot (server only)
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-4-1-fast-non-reasoning
